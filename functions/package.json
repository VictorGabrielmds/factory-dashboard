{
  "name": "functions",
  "description": "Backend WhatsApp Business — pedidos, chat e pagamentos",
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-factory-dashboard --only firestore,storage \"node --test test/regrasAcesso.rules.js\"",
    "test:ci": "npm run test && npm run test:rules",
    "lint": "node scripts/lint.js",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.7.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.29.0",
    "picomatch": "4.0.7"
  }
}
